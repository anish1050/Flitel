{
  "name": "flitel-b2c-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup:db": "tsx --env-file-if-exists=.env.local src/setup-cache.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "hono": "^4.12.12",
    "mongodb": "^7.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
