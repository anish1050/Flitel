PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:3000
DUFFEL_ACCESS_TOKEN=
LITEAPI_KEY=
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DBNAME=flitel
# Long random strings. SESSION_SECRET signs sign-in tokens; FLITEL_API_SECRET must match the web app.
SESSION_SECRET=
FLITEL_API_SECRET=
# Email codes, first match wins: SMTP_USER + SMTP_PASSWORD (a mailbox, e.g. Gmail app password; no domain needed),
# then RESEND_API_KEY + EMAIL_FROM (needs a verified domain). OTP_DEV_ECHO=true prints codes to the console instead (local only).
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=
RESEND_API_KEY=
EMAIL_FROM=
OTP_DEV_ECHO=
# Google sign-in: the OAuth client ID from Google Cloud (not secret). The web app needs the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
