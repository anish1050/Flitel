FLITEL_API_SECRET=
# Email codes: set RESEND_API_KEY and EMAIL_FROM in production. OTP_DEV_ECHO=true prints codes to the console instead (local only).
RESEND_API_KEY=
EMAIL_FROM=
OTP_DEV_ECHO=
